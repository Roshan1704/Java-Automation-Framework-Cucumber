<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UI Automation Test Suite" parallel="tests" thread-count="3">
    
    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
    </listeners>

    <!-- Smoke Test Suite -->
    <test name="Smoke Tests - Chrome" parallel="false">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.automation.runners.TestNGCucumberRunner"/>
        </classes>
    </test>

    <!-- Regression Test Suite -->
    <test name="Regression Tests - Firefox" parallel="false">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.automation.runners.TestNGCucumberRunner"/>
        </classes>
    </test>

    <!-- API Test Suite -->
    <test name="API Tests">
        <classes>
            <class name="com.automation.tests.api.APITest"/>
        </classes>
    </test>

</suite>
